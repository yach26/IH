# Database: leave empty for local zero-config SQLite, or set NeonDB connection string:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Local storage configuration:
AGROTWIN_DB=./agrotwin_api/agrotwin.db
AGROTWIN_UPLOADS=./uploads

# Weather Integration:
# Open-Meteo is used by default for weather forecasts (free public API, no key required).

# Frontend Configuration:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional text generation (choose one provider; server-side only):
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# XAI_API_KEY=
XAI_MODEL=grok-4.3
# Optional EasyOCR cache override; defaults to agrotwin_api/.cache/easyocr:
# AGROTWIN_OCR_MODELS=
