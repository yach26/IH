# AgroTwin AI - Environment Variables
# ====================================
# Copy this file to .env and fill in values as needed.
# All variables are optional; the system runs fully offline without them.

# Database
# --------
# Leave DATABASE_URL empty for local zero-config SQLite.
# Set to a Postgres connection string for production (e.g., Neon).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Local storage (SQLite mode only)
# --------------------------------
AGROTWIN_DB=./agrotwin_api/agrotwin.db
AGROTWIN_UPLOADS=./uploads

# Weather Integration
# -------------------
# Open-Meteo is used by default (free public API, no key required).
# No configuration needed.

# Frontend Configuration
# ----------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional LLM Text Generation (choose one provider)
# --------------------------------------------------
# Used ONLY for narrative explanations. Never for fertilizer quantities.
# If neither key is set, narratives are empty and the system runs fully offline.

# Groq (recommended for speed)
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# xAI (Grok)
# XAI_API_KEY=
XAI_MODEL=grok-4.3

# OCR Configuration
# -----------------
# EasyOCR model cache directory. Defaults to agrotwin_api/.cache/easyocr
# AGROTWIN_OCR_MODELS=

# API Server
# ----------
# Host and port for uvicorn (Docker sets these automatically)
# AGROTWIN_HOST=0.0.0.0
# AGROTWIN_PORT=8000
