# Database: leave empty for local zero-config SQLite, or set NeonDB connection string:
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Local storage configuration:
AGROTWIN_DB=./agrotwin_api/agrotwin.db
AGROTWIN_UPLOADS=./uploads

# Weather Integration:
# Open-Meteo is used by default for weather forecasts (free public API, no key required).

# Frontend Configuration:
NEXT_PUBLIC_API_URL=http://localhost:8000
